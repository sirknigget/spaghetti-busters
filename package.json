{
  "name": "spaghetti-busters",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:oxlint && npm run lint:eslint && npm run lint:css",
    "lint:oxlint": "oxlint --type-aware --tsconfig tsconfig.lint.json .",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings 0"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.27.2",
    "@playwright/test": "^1.56.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@stylistic/stylelint-plugin": "5.3.1",
    "@types/node": "22.20.5",
    "@types/three": "^0.186.0",
    "@typescript-eslint/parser": "8.71.2",
    "@typescript-eslint/utils": "8.71.2",
    "eslint": "10.12.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "78.0.0",
    "jiti": "2.7.0",
    "oxlint": "1.88.0",
    "oxlint-plugin-anti-slop": "git+https://github.com/sirknigget/anti-slop.git#aa6fd941330b4e73a59bff0570344cba35ff0f4d",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  }
}
