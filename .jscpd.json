{
  "path": ["."],
  "mode": "weak",
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.git/**",
    "**/package-lock.json",
    "**/playwright-report/**",
    "**/test-results/**",
    "**/coverage/**",
    "**/.quality-results/**",
    "**/.jscpd/**",
    "**/public/**"
  ],
  "reporters": ["console", "json"],
  "output": ".quality-results/jscpd",
  "failOnEmpty": true
}
