{
  "extends": "./runtime.json",
  "forbidden": [
    {
      "name": "unstable-module-dependency",
      "severity": "warn",
      "from": {
        "path": "^src/"
      },
      "to": {
        "path": "^src/",
        "moreUnstable": true
      }
    },
    {
      "name": "unstable-folder-dependency",
      "scope": "folder",
      "severity": "warn",
      "from": {
        "path": "^src/"
      },
      "to": {
        "path": "^src/",
        "moreUnstable": true
      }
    }
  ]
}
